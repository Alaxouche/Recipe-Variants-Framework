// Skyrim Food Expansion -- RecipeVariantsFramework groups.
//
// Every recipe names one item (the base). With these groups, any variant of that
// item counts at the cooking pot and the oven: one Apple Cabbage Stew recipe
// accepts every apple instead of one copy of the recipe per apple.
//
// Groups below are the ones a recipe actually needs, taken from
// Skyrim Food Expansion.esp 3.1.1 and the vanilla masters: the variants SFE
// duplicates recipes for, plus vanilla ingredients (carrot, bread, salmon) whose
// SFE variants currently cannot be cooked at all.
{
	"$schema_version": 1,
	"groups": [
		{
			"name": "Apple",
			"base": "Skyrim.esm|0x064B2E",                         // Red Apple
			"variants": [
				"Skyrim.esm|0x064B2F",                             // Green Apple
				"Skyrim Food Expansion.esp|0x000005",              // Alax_Apple03
				"Skyrim Food Expansion.esp|0x000006",              // Alax_Apple04
				"Skyrim Food Expansion.esp|0x000007",              // Alax_Apple05
				"Skyrim Food Expansion.esp|0x000008",              // Alax_Apple06
				"Skyrim Food Expansion.esp|0x000009"               // Alax_Apple07 (green)
			],
			"workbench_keywords": ["CraftingCookpot", "BYOHCraftingOven"],
			"requires": "Skyrim Food Expansion.esp"
		},
		{
			"name": "Potato",
			"base": "Skyrim.esm|0x064B41",                         // Alax_Potato01
			"variants": [
				"Skyrim Food Expansion.esp|0x000043",              // Alax_Potato02
				"Skyrim Food Expansion.esp|0x000044",              // Alax_Potato03
				"Skyrim Food Expansion.esp|0x000045",              // Alax_Potato04
				"Skyrim Food Expansion.esp|0x000092",              // Alax_Potato05
				"Skyrim Food Expansion.esp|0x000093",              // Alax_Potato06
				"Skyrim Food Expansion.esp|0x000094",              // Alax_Potato07
				// Alax_Potato08 is the half the cutting recipes make; the stews
				// already take two of them for one potato.
				{ "form": "Skyrim Food Expansion.esp|0x000095", "per_base": 2 }
			],
			"workbench_keywords": ["CraftingCookpot", "BYOHCraftingOven"],
			"requires": "Skyrim Food Expansion.esp"
		},
		{
			"name": "Tomato",
			"base": "Skyrim.esm|0x064B42",                         // Alax_Tomato01
			"variants": [
